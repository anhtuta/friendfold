# Copy to .env and fill in. Do not commit .env.
# Names only — local Compose credentials live in docker-compose.yml
# (Postgres password is for local use only).

DATABASE_URL=
DATABASE_READ_URL=
REDIS_URL=
API_ADDR=
# Next.js origin the API CORS allowlist uses.
WEB_ORIGIN=
# Go API origin the Next.js server uses (health page).
API_BASE_URL=
# Go API origin the browser uses for cookie-authenticated fetch (CORS).
NEXT_PUBLIC_API_BASE_URL=
SNOWFLAKE_WORKER_ID=
LOG_LEVEL=
PGX_MAX_CONNS=
# Session cookie Secure flag. Unset: true when WEB_ORIGIN is https, false for http.
COOKIE_SECURE=
# Local Mailpit (docker compose): host 127.0.0.1 port 1025, no auth, no STARTTLS.
# Leave username/password empty. Do not put production SMTP credentials here.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=
# Optional, tests only. Mailpit HTTP API (Compose publishes 8025).
# MAILPIT_URL=http://127.0.0.1:8025
