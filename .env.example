# Copy to .env and fill in. Do not commit .env.
# Names only — local Compose credentials live in docker-compose.yml
# (Postgres password is for local use only).
#
# Host ports: Postgres 5435, Redis 6377 (containers stay 5432 / 6379).
# Unset values fall back to backend/internal/platform/config defaults.

# postgres://friendfold:friendfold@127.0.0.1:5435/friendfold?sslmode=disable
DATABASE_URL=
# Falls back to DATABASE_URL when empty.
DATABASE_READ_URL=
# redis://127.0.0.1:6377/0
REDIS_URL=
API_ADDR=
# Next.js origin the API CORS allowlist uses.
WEB_ORIGIN=
# Go API origin the Next.js server uses (health page).
API_BASE_URL=
# Go API origin the browser uses for cookie-authenticated fetch (CORS).
NEXT_PUBLIC_API_BASE_URL=
SNOWFLAKE_WORKER_ID=
LOG_LEVEL=
PGX_MAX_CONNS=
# Session cookie Secure flag. Unset: true when WEB_ORIGIN is https, false for http.
COOKIE_SECURE=
# Local Mailpit (docker compose): host 127.0.0.1 port 1025, no auth, no STARTTLS.
# Leave username/password empty. Do not put production SMTP credentials here.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=
# Optional, tests only. Mailpit HTTP API (Compose publishes 8025).
# MAILPIT_URL=http://127.0.0.1:8025
# Object storage (ADR 0009). Default fs; Compose RustFS is host :9000 when MEDIA_DRIVER=s3.
# Local-only S3 access/secret is friendfold/friendfold (docker-compose.yml).
MEDIA_DRIVER=
MEDIA_DIR=
MEDIA_PUBLIC_BASE_URL=
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=
MEDIA_S3_USE_SSL=
MEDIA_S3_PATH_STYLE=
